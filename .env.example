# BioPhysLab — пример конфигурации. Скопируйте в .env и заполните значения.

# --- База данных PostgreSQL ---
# Значения по умолчанию совпадают с docker-compose.yml.
# Контейнер публикуется на порту 5434 (порт 5432 на хосте занят локальным PostgreSQL).
DATABASE_URL=postgresql+asyncpg://biophyslab:biophyslab@localhost:5434/biophyslab

# --- AI-провайдер ---
# Ключ хранится только на сервере, в браузер не отдаётся.
# Как получить:
#   Gemini:  https://aistudio.google.com/app/apikey → "Create API key" (бесплатно)
#   OpenAI:  https://platform.openai.com/api-keys → "Create new secret key"
AI_API_KEY=

# Провайдер: "gemini" или "openai"
AI_PROVIDER=gemini

# Название модели провайдера (примеры: gemini-1.5-flash, gpt-4o-mini)
AI_MODEL=gemini-1.5-flash

# --- OpenAI-совместимый прокси (используется при AI_PROVIDER=openai) ---
# Провайдер, модель и base URL для OpenAI-совместимых прокси:
# для OpenAI-совместимых прокси укажите свой base_url
#AI_PROVIDER=openai
#AI_MODEL=claude-opus-5.5
#AI_BASE_URL=https://api.openai.com/v1

# --- Секрет для подписи cookie-сессий ---
# Любая случайная строка, например вывод: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Cookie-сессии ---
SESSION_COOKIE_NAME=biophyslab_sid

# --- AI-клиент ---
# Таймаут запроса к AI-провайдеру, секунд
AI_TIMEOUT_SECONDS=30

# --- Rate limit ---
# Максимум запросов к AI-модулям в час на одну cookie-сессию
RATE_LIMIT_PER_HOUR=30
